# Copy this file to .env and fill in your camera's WiFi AP details.
# Sony's "Send to Smartphone" AP credentials are static (shown on the
# camera's screen when you enable pairing) -- set them here once.

WIFI_SSID=DIRECT-xxxx:ILCE-XXXX
WIFI_PASSWORD=changeme

# Name of the dedicated USB WiFi interface inside the VM (check with
# `ip link show` after passing the adapter through from Proxmox -- don't
# assume it's wlan1).
WIFI_INTERFACE=wlan1

# Defaults match the camera's fixed AP address; only change these if your
# camera model uses something different.
CAMERA_IP=192.168.122.1
CAMERA_PORT=64321

# Login for the web UI itself. Required: the app refuses to start without
# all three set (see "Access control" in README.md). Generate the secret
# key with: openssl rand -hex 32
WEBAPP_USERNAME=changeme
WEBAPP_PASSWORD=changeme
WEBAPP_SECRET_KEY=changeme

# Port the app listens on. With network_mode: host there's no Docker port
# mapping, this is the actual port on the homeserver, so change it here
# (not in docker-compose.yml) if 8000 is already taken on that machine.
WEBAPP_PORT=8000
